# 密钥与本地环境
.env
runtime/rights-cloud-before.env
runtime/rights-tunnel-venv/
.env.*
!.env.example

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# 日志与临时文件
*.log
*.tmp
*.bak
*.swp
~$*

# 本地运行缓存
.cache/
.playwright/
node_modules/
temp/
runtime/monthly-report-browser-profile/
runtime/monthly-report-browser-output/
runtime/playwright-mcp-probe-profile/
runtime/playwright-mcp-probe-output/

# 备份中的二进制缓存文件，不影响源码恢复
backup/*.pyc
backup/__pycache__/
runtime/rights-ssh-env/

# Machine-local search endpoints may contain authentication settings.
/runtime/search-cli/mcporter.json
/runtime/migration-recovery-20261016/

# Keep development graph cache/snapshots out of source control.
/.codebase-memory/

# Local task workspaces and reversible cleanup archives.
/.work/
/backup/root-cleanup-*/
*.bak-*
*.bak_*

# 本地模型权重（不随 Git 提交）
forecast-engine/_models/
