map_hash_bucket_size 128;

map $http_authorization $mcp_authorized {
    default 0;
    "Bearer ${MCP_API_TOKEN}" 1;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 2m;

    if ($mcp_authorized = 0) { return 401; }

    location /mcp/policy {
        proxy_pass http://policy-mcp:8811/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location /mcp/rights {
        proxy_pass http://rights-mcp:8812/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location /mcp/new-car {
        proxy_pass http://new-car-mcp:8813/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location /mcp/reputation {
        proxy_pass http://reputation-mcp:8814/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location /api/v1/ {
        proxy_pass http://data-api:8815/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
    location /downloads/ {
        alias /srv/mcp-exports/;
        add_header Content-Disposition "attachment";
    }
}
