# Model provider credentials are configured separately.

# Four independent market-data MCP plugins.
MARKET_MCP_BASE_URL=http://192.168.3.146:8790
MARKET_MCP_API_TOKEN=replace-with-a-new-token

# Optional per-plugin switches. Omit them to use model_config/config.json.
MARKET_MCP_POLICY_ENABLED=true
MARKET_MCP_RIGHTS_ENABLED=true
MARKET_MCP_NEW_CAR_ENABLED=true
MARKET_MCP_REPUTATION_ENABLED=true
